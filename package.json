{
  "name": "auth-system",
  "version": "1.0.0",
  "description": "auth.system — cadastro de usuarios e autenticacao com Node.js, Express, TypeScript, Prisma e JWT",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && vite build && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p web",
    "web:dev": "vite",
    "web:build": "vite build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:sql": "tsx scripts/show-sql.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "express",
    "typescript",
    "jwt",
    "bcrypt",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/express-api-reference": "^0.10.26",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "^7.10.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.2"
  }
}
