# porta do servidor
PORT=3000

# segredo do JWT, gere um aleatorio
JWT_SECRET=secret-jwt

# validade do token
JWT_EXPIRES_IN=1h

# senha precisa de percent-encoding
DATABASE_URL="postgresql://postgres:senha-codificada@localhost:5432/sistema_login?schema=public"

# conexoes simultaneas no pool
PGPOOL_MAX=10

# custo do bcrypt
BCRYPT_SALT_ROUNDS=12
